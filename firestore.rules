rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every collection requires a signed-in user.
    // Users may only create/update their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in ['patients', 'doctors', 'departments', 'appointments',
                          'medical_records', 'lab_tests', 'medicines', 'billing', 'employees'];
    }
  }
}
